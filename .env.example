# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google OAuth Client ID (For real/legal Google login)
# Retrieve your secure Client ID from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_CLIENT_ID="9579879038-ja6iglju7l5658qgchsk30io8n4i8j8s.apps.googleusercontent.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# APP_URL="MY_APP_URL"

# SMTP Mail Configurations (For sending OTP and password reset emails via Nodemailer)
# You can use a free Gmail account with an App Password or any other SMTP provider (like Brevo, Mailjet etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
